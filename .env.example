# 이 파일을 복사해서 .env 로 만들어 사용하세요.
#   복사 명령(Windows): copy .env.example .env

# CORS 허용 출처 (스프링 서버 주소). 여러 개면 콤마로 구분. * 는 전체 허용.
#   예) CORS_ORIGINS=http://localhost:8080
CORS_ORIGINS=*

# 스프링부트만 이 서버를 호출하도록 막을 때 쓰는 공유 키 (선택, 비우면 검사 안 함)
SERVICE_API_KEY=

# 통합 발음 정확도 = STT_WEIGHT * STT정확도 + MEDIAPIPE_WEIGHT * 입모양정확도 (합이 1.0이 되도록)
STT_WEIGHT=0.7
MEDIAPIPE_WEIGHT=0.3

# 통합 발음 정확도가 이 값(%) 이상이면 "맞은 것"으로 판정
PASS_THRESHOLD=85.0

# 입모양 정확도 채점 민감도 (지수 감쇠 상수). 값이 클수록 같은 오차에도 점수가
# 더 가파르게 떨어짐. 비슷하게 찍은 영상인데도 점수가 너무 낮게 나오면 낮추세요.
MOUTH_ACCURACY_DECAY=0.5

# 원어민 발음 랜드마크를 저장할 MySQL 접속 정보 (SQLAlchemy 접속 문자열)
#   예) DATABASE_URL=mysql+pymysql://root:내비밀번호@localhost:3306/pronunciation_ai
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pronunciation_ai